rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdultProfile() {
      return request.resource.data.age is int && request.resource.data.age >= 18;
    }

    function isParticipantByIds(user1Id, user2Id) {
      return signedIn() && (request.auth.uid == user1Id || request.auth.uid == user2Id);
    }

    function conversationParticipants(convId) {
      return get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
    }

    match /users/{uid} {
      allow read: if signedIn() && resource.data.isBanned != true;
      allow create: if isSelf(uid)
        && isAdultProfile()
        && request.resource.data.isBanned == false
        && request.resource.data.isVerified == false;
      allow update: if isSelf(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isBanned', 'isVerified', 'matchesCount', 'signalsSent', 'createdAt'
        ]);
      allow delete: if false;
    }

    match /signals/{signalId} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);

      allow create: if signedIn()
        && request.auth.uid == request.resource.data.senderId
        && request.resource.data.senderId != request.resource.data.receiverId
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp;

      allow update: if signedIn()
        && request.auth.uid == resource.data.receiverId
        && resource.data.status == 'pending'
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.receiverId == resource.data.receiverId
        && request.resource.data.status in ['accepted', 'declined'];

      allow delete: if false;
    }

    match /matches/{matchId} {
      allow read: if isParticipantByIds(resource.data.user1Id, resource.data.user2Id);
      allow create: if false;
      allow update: if isParticipantByIds(resource.data.user1Id, resource.data.user2Id)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'user1Id', 'user2Id', 'createdAt'
        ]);
      allow delete: if false;
    }

    match /venues/{venueId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if signedIn() && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in conversationParticipants(conversationId);
        allow create: if signedIn()
          && request.auth.uid in conversationParticipants(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update: if signedIn() && request.auth.uid in conversationParticipants(conversationId);
        allow delete: if false;
      }
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUserId is string
        && request.resource.data.reason is string;
      allow read, update, delete: if false;
    }
  }
}
