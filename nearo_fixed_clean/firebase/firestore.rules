rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdultProfile() {
      return request.resource.data.age is int && request.resource.data.age >= 18;
    }

    function inList(list) {
      return signedIn() && request.auth.uid in list;
    }

    function matchParticipant(matchId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.userIds;
    }

    function requestedMatchParticipant(matchId, uid) {
      return uid in get(/databases/$(database)/documents/matches/$(matchId)).data.userIds;
    }

    function conversationParticipants(convId) {
      return get(/databases/$(database)/documents/conversations/$(convId)).data.userIds;
    }

    function immutableSignalFields() {
      return ['senderId', 'receiverId', 'createdAt', 'expiresAt', 'cooldownUntil', 'venueId', 'venueWifiHash'];
    }

    match /users/{uid} {
      allow read: if signedIn() && resource.data.isBanned != true;
      allow create: if isSelf(uid)
        && isAdultProfile()
        && request.resource.data.isBanned == false
        && request.resource.data.visible is bool
        && request.resource.data.phoneNumber == ''
        && request.resource.data.socials == {}
        && !request.resource.data.keys().hasAny(['blockedUsers', 'fcmToken']);
      allow update: if isSelf(uid)
        && request.resource.data.phoneNumber == ''
        && request.resource.data.socials == {}
        && !request.resource.data.keys().hasAny(['blockedUsers', 'fcmToken'])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isBanned', 'isVerified', 'matchesCount', 'signalsSent', 'createdAt'
        ]);
      allow delete: if false;

      match /private/{docId} {
        allow read, write: if isSelf(uid);
      }
    }

    match /signals/{signalId} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);

      allow create: if signedIn()
        && request.auth.uid == request.resource.data.senderId
        && request.resource.data.senderId != request.resource.data.receiverId
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp;

      allow update: if signedIn()
        && request.auth.uid == resource.data.receiverId
        && resource.data.status == 'pending'
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.receiverId == resource.data.receiverId
        && request.resource.data.status in ['accepted', 'declined']
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(immutableSignalFields());

      allow update: if signedIn()
        && request.auth.uid == resource.data.senderId
        && resource.data.status == 'pending'
        && resource.data.expiresAt <= request.time
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.receiverId == resource.data.receiverId
        && request.resource.data.status == 'expired'
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(immutableSignalFields());

      allow delete: if false;
    }

    match /matches/{matchId} {
      allow read: if inList(resource.data.userIds);
      allow create: if false;
      allow update: if inList(resource.data.userIds)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'userIds', 'user1Id', 'user2Id', 'createdAt', 'conversationId', 'connectionId'
        ]);
      allow delete: if false;
    }

    match /connections/{connectionId} {
      allow read: if inList(resource.data.userIds);
      allow create: if false;
      allow update: if inList(resource.data.userIds)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'userIds', 'matchId', 'createdAt', 'expiresAt'
        ]);
      allow delete: if false;
    }

    match /contactReveals/{revealId} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.requesterId || request.auth.uid == resource.data.receiverId);
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.requesterId
        && matchParticipant(request.resource.data.matchId)
        && requestedMatchParticipant(request.resource.data.matchId, request.resource.data.receiverId)
        && request.resource.data.requesterId != request.resource.data.receiverId
        && request.resource.data.contactType in ['phone', 'instagram', 'telegram', 'whatsapp']
        && request.resource.data.status == 'requested'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && !request.resource.data.keys().hasAny(['revealedValue', 'approvedAt']);
      allow update: if signedIn()
        && request.auth.uid == resource.data.receiverId
        && resource.data.status == 'requested'
        && request.resource.data.status in ['approved', 'declined']
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'matchId', 'requesterId', 'receiverId', 'contactType', 'createdAt', 'expiresAt', 'revealedValue', 'approvedAt'
        ]);
      allow delete: if false;
    }

    match /venues/{venueId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /venueEvents/{eventId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /icebreakers/{icebreakerId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.userIds;
      allow create: if false;
      allow update: if signedIn()
        && request.auth.uid in resource.data.userIds
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'userIds', 'participants', 'matchId', 'createdAt'
        ]);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in conversationParticipants(conversationId);
        allow create: if signedIn()
          && request.auth.uid in conversationParticipants(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if false;
      }
    }

    match /blocks/{blockId} {
      allow read: if signedIn() && request.auth.uid == resource.data.blockerId;
      allow create: if signedIn()
        && blockId == request.auth.uid + '_' + request.resource.data.blockedUserId
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedUserId is string
        && request.resource.data.blockedUserId != request.auth.uid;
      allow update, delete: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUserId is string
        && request.resource.data.reason is string;
      allow read, update, delete: if false;
    }

    match /moderationQueue/{itemId} {
      allow read, write: if false;
    }
  }
}
